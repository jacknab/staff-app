modules = ["nodejs-20", "web", "bash"]

[nix]
channel = "stable-25_05"
packages = ["glib", "nspr", "nss", "dbus"]

[agent]
expertMode = true

[[ports]]
localPort = 5000
externalPort = 5000
exposeLocalhost = true

[[ports]]
localPort = 25053
externalPort = 80
exposeLocalhost = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/certxa-pro: expo"

[[workflows.workflow]]
name = "artifacts/certxa-pro: expo"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/certxa-pro run dev"
waitForPort = 25053

[workflows.workflow.metadata]
outputType = "console"
