{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://certxa.com",
        "PNPM_CONFIG_STRICT_DEP_BUILDS": "false"
      }
    },
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://certxa.com",
        "PNPM_CONFIG_STRICT_DEP_BUILDS": "false"
      }
    },
    "preview-dev": {
      "extends": "preview",
      "ios": {
        "credentialsSource": "local"
      }
    }
  }
}
