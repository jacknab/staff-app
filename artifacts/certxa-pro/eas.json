{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://certxa.com",
        "PNPM_CONFIG_STRICT_DEP_BUILDS": "false",
        "EXPO_PUBLIC_APNS_ENV": "production"
      },
      "channel": "preview"
    },
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://certxa.com",
        "PNPM_CONFIG_STRICT_DEP_BUILDS": "false",
        "EXPO_PUBLIC_APNS_ENV": "production"
      },
      "channel": "production"
    },
    "preview-dev": {
      "extends": "preview",
      "ios": {
        "credentialsSource": "local"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://certxa.com",
        "PNPM_CONFIG_STRICT_DEP_BUILDS": "false",
        "EXPO_PUBLIC_APNS_ENV": "development"
      },
      "channel": "preview-dev"
    }
  }
}
